<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.thokodi"
       name="thokodi Repository"
       version="1.0.0"
       provider-name="thokodi">
  <extension point="xbmc.addon.repository" name="thokodi repo">
    <dir>
      <info compressed="false">https://thokodi.github.io/repo/repository.thokodi/addons.xml</info>
      <checksum>https://thokodi.github.io/repo/repository.thokodi/addons.xml.md5</checksum>
      <datadir zip="true">https://f003.backblazeb2.com/file/thokodi/</datadir>
    </dir>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary>thokodi repository</summary>
    <description>custom build</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>

<addon id="plugin.video.thokodi" name="thokodi" version="1.0.1" provider-name="thokodi">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">thokodi</summary>
    <description lang="en">thokodi</description>
	<website></website>
    <platform>all</platform>
  </extension>
</addon>
</addons>
